rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Master data: Locations
    match /locations/{locationId} {
      allow read: if true;
      allow write: if true;
    }

    // Master data: Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Rounds
    match /rounds/{roundId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Observations
    match /observations/{obsId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Observation Updates (Audit trail - immutable history)
    match /observationUpdates/{updateId} {
      allow read: if true;
      allow create: if request.resource.data.type in ['comment', 'resolved', 'reopened'];
      // Strictly prevent editing or deleting historical updates to preserve audit integrity
      allow update, delete: if false;
    }
  }
}
